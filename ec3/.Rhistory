---
title: 'Case Study 01: Comparação do IMC médio de alunos do PPGEE-UFMG ao longo de dois
semestres'
---
title: 'Case Study 01: Comparação do IMC médio de alunos do PPGEE-UFMG ao longo de dois
semestres'
---
title: 'Caso de Estudo 01: Comparação do IMC médio de alunos do PPGEE-UFMG ao longo de dois
semestres'
# clean workspace
rm(list = ls())
# install required packages if needed
if (!("ExpDE" %in% rownames(installed.packages()))){
install.packages("ExpDE")
}
if (!("smoof" %in% rownames(installed.packages()))){
install.packages("smoof")
}
#====================================================
suppressWarnings(suppressPackageStartupMessages(library(smoof)))
suppressPackageStartupMessages(library(ExpDE))
# ---------------------------------------------------------------------------
# 1. Configurações (Equipe E)
# ---------------------------------------------------------------------------
## Config 1
recpars1 <- list(name = "recombination_lbga")
mutpars1 <- list(name = "mutation_rand", f = 4.5)
## Config 2
recpars2 <- list(name = "recombination_blxAlphaBeta", alpha = 0.1, beta = 0.4)
mutpars2 <- list(name = "mutation_rand", f = 3)
config <- list(list(rec = recpars1, mut = mutpars1),
list(rec = recpars2, mut = mutpars2))
selpars <- list(name = "selection_standard")
# ---------------------------------------------------------------------------
# 2. Função-problema (Rosenbrock) e execução do ExpDE
#
# Por que NÃO usar apply() + smoof aqui: o ExpDE avalia a função em toda a
# população a cada geração (até 5000*dim avaliações por execução). Chamar a
# função do smoof linha a linha torna cada execução lenta (principalmente em
# dim alto), e o experimento todo exige milhares de execuções.
# A versão abaixo calcula a mesma função de forma vetorizada.
# Como no enunciado, a função precisa se chamar 'fn' e ficar no ambiente global.
# ---------------------------------------------------------------------------
set_instance <- function(dim) {
assign("fn", function(X) {
if (!is.matrix(X)) X <- matrix(X, nrow = 1)
n  <- ncol(X)
xa <- X[, -n, drop = FALSE]
xb <- X[, -1, drop = FALSE]
rowSums(100 * (xa^2 - xb)^2 + (xa - 1)^2)
}, envir = .GlobalEnv)
}
# Verificação: a versão vetorizada deve coincidir com a do smoof
set_instance(10)
Xchk <- matrix(runif(20, -5, 10), nrow = 2)
f_smoof <- smoof::makeRosenbrockFunction(dimensions = 10)
stopifnot(isTRUE(all.equal(as.numeric(fn(Xchk)),
as.numeric(apply(Xchk, 1, f_smoof)))))
# Uma execução do DE na instância 'dim' com a configuração 'cfg': devolve Fbest
run_de <- function(dim, cfg) {
out <- ExpDE(mutpars  = cfg$mut,
recpars  = cfg$rec,
popsize  = 5 * dim,
selpars  = selpars,
stopcrit = list(names = "stop_maxeval",
maxevals = 5000 * dim,
maxiter  = 100 * dim),
probpars = list(name = "fn",
xmin = rep(-5, dim), xmax = rep(10, dim)),
showpars = list(show.iters = "none"))
out$Fbest
}
# ---------------------------------------------------------------------------
# 3. Algoritmo 1 (Campelo & Takahashi, 2019): amostragem em UMA instância
#
# Roda as duas configs (n0 vezes cada) e depois acrescenta uma execução por
# vez à config que está abaixo da razão ótima r_opt = s1/s2 (Eq. 11), até que
# o erro padrão de psi_j fique <= se_star ou n1 + n2 atinja nmax.
# Diferença: psi_j = mean(transf(Y2)) - mean(transf(Y1)).
# Com transf = log (recomendado), Fbest > 0 é necessário.
# ---------------------------------------------------------------------------
algoritmo1 <- function(dim, se_star, n0 = 20, nmax = 200, transf = log) {
set_instance(dim)
se_fun <- function(x1, x2) {
sqrt(var(transf(x1)) / length(x1) + var(transf(x2)) / length(x2))   # Eq. (12)
}
x1 <- replicate(n0, run_de(dim, config[[1]]))
x2 <- replicate(n0, run_de(dim, config[[2]]))
se <- se_fun(x1, x2)
while (isTRUE(se > se_star) && (length(x1) + length(x2)) < nmax) {
r_opt <- sd(transf(x1)) / sd(transf(x2))          # Eq. (11)
if (length(x1) / length(x2) < r_opt) {
x1 <- c(x1, run_de(dim, config[[1]]))
} else {
x2 <- c(x2, run_de(dim, config[[2]]))
}
se <- se_fun(x1, x2)
}
list(
resumo = data.frame(dim = dim,
psi = mean(transf(x2)) - mean(transf(x1)),
se = se, n1 = length(x1), n2 = length(x2),
bateu_nmax = isTRUE(se > se_star)),
brutos = rbind(
data.frame(dim = dim, config = 1, rep = seq_along(x1), Fbest = x1),
data.frame(dim = dim, config = 2, rep = seq_along(x2), Fbest = x2))
)
}
# ---------------------------------------------------------------------------
# 4. Piloto: estima sigma_Phi e define se_star (Seção 4.6 do artigo):
#    (se_star)^2 <= 0.1 * sigma_Phi^2  =>  se_star = sqrt(0.1) * sigma_Phi
# ---------------------------------------------------------------------------
piloto <- function(dims_piloto, n_rep = 15, transf = log) {
psi <- numeric(length(dims_piloto))
for (k in seq_along(dims_piloto)) {
d <- dims_piloto[k]
set_instance(d)
y1 <- transf(replicate(n_rep, run_de(d, config[[1]])))
y2 <- transf(replicate(n_rep, run_de(d, config[[2]])))
psi[k] <- mean(y2) - mean(y1)
cat(sprintf("[piloto] dim = %3d (%d/%d) psi = %.3f\n",
d, k, length(dims_piloto), psi[k]))
flush.console()
}
list(dims = dims_piloto, psi = psi, sigma_phi = sd(psi),
se_star = sqrt(0.1) * sd(psi))
}
# ---------------------------------------------------------------------------
# 5. Algoritmo 2 (Campelo & Takahashi, 2019): procedimento completo
#
# 1. Calcula N* (teste t pareado, Eq. 23).
# 2. Verifica se N* cabe no conjunto de instâncias disponíveis.
# 3. Sorteia N* instâncias (dimensões) sem reposição.
# 4. Aplica o Algoritmo 1 em cada uma e obtém psi_j.
# 5. Testa H0: mu_D = 0 sobre os psi_j (um valor por instância).
# 6. Verifica a normalidade dos psi_j.
# ---------------------------------------------------------------------------
algoritmo2 <- function(se_star, instancias = 2:150, excluir = integer(0),
d_star = 0.5, alpha = 0.05, potencia = 0.8,
N_inst = NULL, n0 = 20, nmax = 200, transf = log) {
# 1. Número de instâncias
N_star <- ceiling(power.t.test(delta = d_star, sd = 1, sig.level = alpha,
power = potencia, type = "paired",
alternative = "two.sided")$n)
if (is.null(N_inst)) N_inst <- N_star          # use N_inst = 40 ou 54 se necessário
# 2. N* cabe no conjunto disponível?
disponiveis <- setdiff(instancias, excluir)
if (N_inst > length(disponiveis)) {
stop("N* maior que o número de instâncias disponíveis.")
}
# 3. Sorteio sem reposição
dims <- sort(sample(disponiveis, size = N_inst, replace = FALSE))
# 4. Algoritmo 1 em cada instância
res <- vector("list", length(dims))
for (k in seq_along(dims)) {
t0 <- Sys.time()
res[[k]] <- algoritmo1(dims[k], se_star, n0 = n0, nmax = nmax, transf = transf)
cat(sprintf("[exp] dim = %3d (%d/%d) n1 = %3d n2 = %3d | %.1f s\n",
dims[k], k, length(dims),
res[[k]]$resumo$n1, res[[k]]$resumo$n2,
as.numeric(difftime(Sys.time(), t0, units = "secs"))))
flush.console()
}
tabela <- do.call(rbind, lapply(res, `[[`, "resumo"))
brutos <- do.call(rbind, lapply(res, `[[`, "brutos"))
# 5. Teste de hipóteses (bilateral)
teste <- t.test(tabela$psi, mu = 0, alternative = "two.sided",
conf.level = 1 - alpha)
# 6. Premissas
shap <- shapiro.test(tabela$psi)
qqnorm(tabela$psi, main = "QQ-plot dos psi_j"); qqline(tabela$psi)
list(N_star = N_star, N_inst = N_inst, dims = dims,
tabela = tabela, brutos = brutos, teste = teste, shapiro = shap)
}
# ===========================================================================
# EXECUÇÃO
# ===========================================================================
set.seed(1997)                                   # semente única e fixa
# 5.0 Teste de tempo: rode ANTES de tudo para ter noção do custo
for (d in c(10, 150)) {
set_instance(d)
tt <- system.time(run_de(d, config[[1]]))[["elapsed"]]
cat(sprintf("Uma execução com dim = %3d levou %.1f s\n", d, tt))
}
# Estimativa grosseira do total: (nº de execuções) x (tempo médio por execução).
# Mínimo de execuções: N* x 2 x n0 (ex.: 34 x 2 x 20 = 1360), podendo chegar a N* x nmax.
# 5.1 Piloto (dimensões fora da amostra do experimento)
dims_piloto <- sort(sample(2:150, size = 8))
pil         <- piloto(dims_piloto, n_rep = 15)
# clean workspace
rm(list = ls())
# install required packages if needed
if (!("ExpDE" %in% rownames(installed.packages()))){
install.packages("ExpDE")
}
if (!("smoof" %in% rownames(installed.packages()))){
install.packages("smoof")
}
#====================================================
suppressWarnings(suppressPackageStartupMessages(library(smoof)))
